### ============================================================
###  小米 CR6608（MT7621）基础配置种子
###  - 目标：ramips / mt7621 / xiaomi_mi-router-cr6608
###  - 这里只放「基础系统 + 默认组件」；插件增删请改 custom/packages.seed，
###    无线栈（MTK 闭源 / 开源 mt76）由 scripts/custom/customize.sh 按 MTK_WIFI 决定。
###  - 注：wpad / wifi-scripts / kmod-mac80211 故意不写在此处，
###    以免与 MTK 闭源驱动冲突；回退开源时由 fallback-openwrt-wifi.sh 打开。
### ============================================================

# ---- 目标平台与机型 ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y

# ---- 内核构建标识 ----
CONFIG_KERNEL_BUILD_DOMAIN="CR6608"
CONFIG_KERNEL_BUILD_USER="builder"

# ---- 基础系统 ----
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
# fw4 是 firewall4 的 PROVIDES 虚拟名，没有同名真实包，写了会被 defconfig 静默丢弃
# CONFIG_PACKAGE_fw4 is not set
# iptables / ip6tables 都是 PROVIDES 虚拟名，真实包是 iptables-nft
CONFIG_PACKAGE_iptables-nft=y
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
# nftables 是 PROVIDES 虚拟名，真实包为 nftables-json
# CONFIG_PACKAGE_nftables is not set
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# ---- SSL 后端：全局只能有 1 个 libustream-ssl 变体 ----
# customize.sh 会把 libustream-openssl 从 include/target.mk 的 DEFAULT_PACKAGES 里删掉，
# 这里显式声明 mbedtls（体积最小，对 CR6608 的 Flash 友好）。
CONFIG_PACKAGE_libustream-mbedtls=y
# CONFIG_PACKAGE_libustream-openssl is not set
# CONFIG_PACKAGE_libustream-wolfssl is not set

# ---- LuCI Web 界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_luci-lua-runtime=y

# ---- 中文界面 / 时区 ----
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y

# ---- 有线/无线扩展：WOL 与 UPNP（本仓库原有能力）----
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-upnp=y
# miniupnpd 是 PROVIDES 虚拟名，24.10 的真实包是 miniupnpd-nftables
CONFIG_PACKAGE_miniupnpd-nftables=y

# ---- 网络工具 ----
CONFIG_PACKAGE_curl=y
# wget 是 PROVIDES 虚拟名，真实包是 wget-ssl
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
CONFIG_PACKAGE_wireless-tools=y
# tc 是 PROVIDES 虚拟名，真实包是 tc-full
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ---- 硬件加速：内核自带 MTK PPE（MT7621 的 mtk_eth_soc）+ nft 流卸载 ----
CONFIG_PACKAGE_kmod-nft-offload=y

# ---- 编译选项 ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BUILD_NLS=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
