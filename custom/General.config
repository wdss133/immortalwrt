### ============================================================
###  ImmortalWrt IPQ807X 通用配置（CI 定制）
###  本文件由 CI 直接使用；插件开关集中在 custom/packages.seed，
###  增删插件请改那个文件，不必动本文件。
### ============================================================

CONFIG_DEVEL=y
CONFIG_CCACHE=y

### ---- 中文界面 / 时区（沿用仓库自带汉化）----
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_zoneinfo-asia=y

### ---- 基础增强 ----
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssh-sftp-server=y

### ---- 仓库原有：WOL / UPNP ----
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-upnp=y

### ---- 默认主题：argon（并移除 Aurora）----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-aurora is not set
# CONFIG_PACKAGE_luci-app-aurora-config is not set

### ---- 内核模块：ZeroTier / EasyTier 依赖 TUN ----
CONFIG_PACKAGE_kmod-tun=y

### ---- MTK 闭源无线（来自 MTK SDK）----
###  IPQ807X 是 Qualcomm 平台，使用内核自带 ath11k，不需要 MTK 驱动。
###  如果将来改编译 mediatek/* 目标，把下面两行改成 =y，或给编译脚本传 ENABLE_MTK_WIFI=1。
# CONFIG_PACKAGE_kmod-mt7915 is not set
# CONFIG_PACKAGE_luci-app-mtk is not set
# CONFIG_PACKAGE_wifi-profile is not set
# CONFIG_PACKAGE_datconf-lua is not set
