### ============================================================
###  IPQ807X 目标配置（ImmortalWrt / openwrt-24.10）
###  - 只编译 qualcommax / ipq807x，不编译 ipq60xx 与其它平台
###  - 具体机型由 scripts/custom/immortalwrt-customize.sh 从源码树动态解析后写入本文件，
###    因此上游新增机型会自动跟上，无需手工维护。
### ============================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# 打包格式（opkg/ipk，ImmortalWrt 24.10）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
